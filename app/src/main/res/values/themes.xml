<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Blank" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/blank_background</item>
        <item name="android:navigationBarColor">@color/blank_background</item>
    </style>

    <style name="Theme.Blank.Fullscreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/blank_block_background</item>
        <item name="android:navigationBarColor">@color/blank_block_background</item>
    </style>
</resources>
