<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleDisplayName</key>
	<string>Blanked</string>
	<key>BlankMembershipAPIBaseURL</key>
	<string>$(BLANK_MEMBERSHIP_API_BASE_URL)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>Blanked</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.blanknfc.app.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>blank</string>
			</array>
		</dict>
	</array>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NFCReaderUsageDescription</key>
	<string>Blanked may use NFC for legacy tag backup flows when enabled.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Blanked reads Apple Health data you allow, including sleep, steps, workouts, mindful minutes, heart rate, resting heart rate, HRV and energy, to generate digital wellness insights. It does not provide medical diagnosis.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Blanked does not write data to Apple Health.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Blanked uses Face ID or your device passcode to protect advanced blocking settings when you enable PIN protection.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Blanked uses the microphone so you can dictate messages to Blanked AI.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Blanked uses speech recognition to turn your dictated messages into text for Blanked AI.</string>
	<key>UIAppFonts</key>
	<array>
		<string>instrument_serif_regular.ttf</string>
		<string>inter_variable.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
